---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteMotion from '../components/SiteMotion.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Rebobina — archivo de videojuegos para volver a jugar',
	description = 'Un archivo vivo para descubrir, recordar y volver a jugar videojuegos clásicos.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f3f0e8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<SiteHeader />
		<main id="contenido"><slot /></main>
		<SiteFooter />
		<SiteMotion />
	</body>
</html>
