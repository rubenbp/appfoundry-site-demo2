---
import { getCollection } from 'astro:content';
import GameArt from '../components/GameArt.astro';
import GameCard from '../components/GameCard.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { genres } from '../data/catalog';

const games = await getCollection('juegos');
const featured = games.find((game) => game.data.featured) ?? games[0];
const selection = ['crash-bandicoot', 'final-fantasy-vi', 'puzzle-bobble', 'super-metroid'].map((id) => games.find((game) => game.id === id)!);
const generations = [
	{ label: '8 bits', note: 'Pocos colores, ideas enormes.' },
	{ label: '16 bits', note: 'Más mundo para perderse.' },
	{ label: '32 bits', note: 'Un salto a nuevas dimensiones.' },
];
---

<SiteLayout>
	<section class="hero shell">
		<div class="hero__copy">
			<p class="eyebrow"><span class="status-dot"></span> Archivo abierto · empieza aquí</p>
			<h1>La partida<br />que <span>siempre</span><br />vuelve.</h1>
			<p class="hero__lede">Un archivo vivo de videojuegos clásicos. Para descubrir esa joya que te perdiste y volver a donde lo dejaste.</p>
			<div class="hero__actions">
				<a class="button button--dark" href="/catalogo/">Abrir el catálogo <span aria-hidden="true">↗</span></a>
				<a class="text-link" href="/sobre-rebobina/">Conoce el archivo <span aria-hidden="true">→</span></a>
			</div>
			<div class="hero__stamp"><span>REWIND<br />CLUB</span><span class="hero__stamp-star">✳</span></div>
			<div class="hero__stats"><div><strong>{games.length}</strong><span>juegos con historia</span></div><div><strong>{genres.length}</strong><span>formas de jugar</span></div><div><strong>3</strong><span>épocas para volver</span></div></div>
		</div>
		<div class="hero__visual">
			<div class="hero__visual-top"><span>SELECCIÓN DE LA CASA</span><span>R-001 / {featured.data.year}</span></div>
			<div class="hero__art-wrap"><GameArt visual={featured.data.visual} palette={featured.data.palette} large={true} transitionId={featured.id} /></div>
			<div class="hero__feature">
				<div>
					<p class="eyebrow">La ficha destacada</p>
					<h2>{featured.data.title}</h2>
					<p>{featured.data.platform} <span aria-hidden="true">·</span> {featured.data.year}</p>
				</div>
				<a class="round-link" href={'/juegos/' + featured.id + '/'} aria-label={'Ver ficha de ' + featured.data.title}>↗</a>
			</div>
			<div class="hero__visual-foot"><span>01 — TODO EMPIEZA CON UN CARTUCHO</span><span>DESLIZA PARA EXPLORAR ↓</span></div>
		</div>
	</section>

	<section class="intro-band">
		<div class="shell intro-band__inner">
			<p>NO BUSCAMOS EL PRÓXIMO ESTRENO.</p>
			<p>Buscamos <span>ese juego</span> que aún tiene algo que contar.</p>
			<a href="/sobre-rebobina/" aria-label="Descubre la idea del archivo">↗</a>
		</div>
	</section>

	<section class="section shell" aria-labelledby="new-arrivals-title">
		<div class="section-heading" data-reveal>
			<div><p class="eyebrow">Cuatro maneras de volver</p><h2 id="new-arrivals-title">Un mando, mil mundos.</h2></div>
			<a class="text-link" href="/catalogo/">Ver los {games.length} juegos <span aria-hidden="true">→</span></a>
		</div>
		<div class="game-grid">
			{selection.map((game, index) => <GameCard game={game} index={index} />)}
		</div>
	</section>

	<section class="genre-section" aria-labelledby="genre-title"><div class="shell">
		<div class="section-heading" data-reveal><div><p class="eyebrow">Sigue tu forma de jugar</p><h2 id="genre-title">Cada género, otra puerta.</h2></div><p class="section-heading__note">Todas las épocas.<br />Todos los gustos.</p></div>
		<div class="genre-grid">{genres.map((genre, index) => (
			<a class:list={['genre-tile', 'genre-tile--' + genre.palette]} href={'/catalogo/?genero=' + encodeURIComponent(genre.name.toLowerCase())} data-reveal style={'--reveal-delay:' + (index % 4) * 50 + 'ms'}>
				<div class="genre-tile__top"><span class="genre-tile__mark" aria-hidden="true">{genre.mark}</span><span>{games.filter((game) => game.data.genre === genre.name).length} juegos</span></div>
				<h3>{genre.name}</h3><p>{genre.description}</p><span class="genre-tile__arrow" aria-hidden="true">↗</span>
			</a>
		))}<a class="genre-tile genre-tile--all" href="/catalogo/" data-reveal><div class="genre-tile__top"><span class="genre-tile__mark" aria-hidden="true">↗</span><span>{games.length} juegos</span></div><h3>Tu próxima partida.</h3><p>Abre el archivo. Encuentra tu mundo.</p><span class="genre-tile__arrow" aria-hidden="true">↗</span></a></div>
	</div></section>

	<section class="generation-section">
		<div class="shell generation-section__inner">
			<div class="generation-intro" data-reveal><p class="eyebrow">Tres épocas, infinitas partidas</p><h2>Cambia el píxel.<br /><span>Queda la magia.</span></h2><p>De los primeros saltos a los castillos imposibles: elige tu generación y empieza a explorar.</p></div>
			<div class="generation-list" data-reveal>
				{generations.map((generation) => (
					<a class="generation-row" href={'/catalogo/?generacion=' + encodeURIComponent(generation.label)}>
						<span class="generation-row__number">{String(games.filter((game) => game.data.generation === generation.label).length).padStart(2, '0')}<small>JUEGOS</small></span>
						<span class="generation-row__name">{generation.label}</span>
						<span class="generation-row__note">{generation.note}</span>
						<span class="generation-row__arrow" aria-hidden="true">↗</span>
					</a>
				))}
			</div>
		</div>
	</section>

	<section class="closing-cta shell">
		<div data-reveal><p class="eyebrow">Tu próxima partida ya existe</p><h2>¿Le damos<br />a <span>start</span>?</h2></div>
		<a class="button button--lime" href="/catalogo/">Elegir un juego <span aria-hidden="true">↗</span></a>
		<div class="closing-cta__d-pad" aria-hidden="true"><span>⌃</span><span>◂</span><span>●</span><span>▸</span><span>⌄</span></div>
	</section>
</SiteLayout>
